{
  "name": "blockbench-minecraft-3d-skin-layer",
  "version": "0.3.1",
  "description": "Blockbench plugin: convert Minecraft skin outer layers ('xxx Layer' cubes) into per-pixel voxel cubes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/menton600/blockbench-minecraft-3d-skin-layer.git"
  },
  "bugs": {
    "url": "https://github.com/menton600/blockbench-minecraft-3d-skin-layer/issues"
  },
  "homepage": "https://github.com/menton600/blockbench-minecraft-3d-skin-layer#readme",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pngjs": "^6.0.5",
    "blockbench-types": "^5.1.0",
    "esbuild": "^0.28.2",
    "pngjs": "^7.0.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
